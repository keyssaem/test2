# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 비밀값은 절대 커밋하지 않음. 키 이름만 담은 .env.example만 허용
.env*
!.env.example

# 학생 결과물·내보내기 파일 (개인정보 포함 가능)
/exports/
*.csv
*.xlsx
*.zip

# Supabase 로컬 임시 파일
/supabase/.temp/
/supabase/.branches/

# 에디터·OS
.vscode/
.idea/
Thumbs.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
