# ─────────────────────────────────────────────────────────────
# 이 파일은 "키 이름"만 담은 예시입니다. 실제 값은 넣지 마세요.
# 사용법: 이 파일을 복사해 .env.local 을 만들고 값을 채웁니다.
#   Copy-Item .env.example .env.local
# .env.local 은 .gitignore 에 의해 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# 저장소: memory(체험·개발용, 서버 재시작 시 초기화) | supabase(실제 수업용)
DATA_BACKEND=memory

# [공개 가능] 브라우저로 전달되는 값 — Supabase URL과 anon(공개) 키만 허용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [서버 전용·비밀] 절대 NEXT_PUBLIC_ 을 붙이지 마세요
SUPABASE_SERVICE_ROLE_KEY=
# 비워 두면 AI 없이 키워드 채점으로 동작합니다
ANTHROPIC_API_KEY=
# 채점에 쓸 Claude 모델 (기본: claude-opus-5-5, 비용을 줄이려면 claude-haiku-5-5)
CLAUDE_MODEL=

# [memory 모드 전용] 교사 화면 로그인 코드 (8자 이상). supabase 모드에서는 이메일 로그인을 씁니다.
TEACHER_PASSCODE=

# 학생·교사 세션 쿠키 서명용 비밀값 (32자 이상 무작위 문자열)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDENT_SESSION_SECRET=
